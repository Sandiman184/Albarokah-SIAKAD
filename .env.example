# Konfigurasi Database Lokal
# Salin file ini menjadi .env dan sesuaikan dengan lingkungan Anda
# Jangan pernah menyimpan password produksi di file ini!

# Kunci Keamanan (Ganti dengan string acak untuk produksi)
SECRET_KEY=dev-secret-key-local-only

# Koneksi Database
# Format: postgresql://username:password@host:port/database_name
# Contoh Lokal (PostgreSQL):
DATABASE_URL=postgresql://albarokah_user:alnet%402026@localhost/siakad_db

# Contoh Lokal (SQLite - Jika tidak ada Postgres):
# DATABASE_URL=sqlite:///app.db

# Konfigurasi Email (Opsional untuk Lokal)
MAIL_USERNAME=email@example.com
MAIL_PASSWORD=password_aplikasi
MAIL_DEFAULT_SENDER=email@example.com
